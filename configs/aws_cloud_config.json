{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "project": "IgnisCore — Intelligent Fire Hazard Monitoring System",
  "description": "Production AWS Cloud architecture parameters, IoT Core MQTT routes, DynamoDB schema mapping, and cloud governance policies.",
  "cloud_environment": {
    "provider": "AWS",
    "default_region": "us-east-1",
    "cloudformation_template": "infra/fireguard-infra.yaml",
    "local_first_mode": true
  },
  "aws_iot_core": {
    "endpoint_template": "{account_id}.iot.{region}.amazonaws.com",
    "port": 8883,
    "tls_version": "TLSv1.2",
    "topics": {
      "telemetry_stream": "fireguard/telemetry/{building_id}/{zone_id}",
      "command_broadcast": "fireguard/commands/{building_id}/actuators",
      "alert_stream": "fireguard/alerts/realtime"
    },
    "rules": [
      {
        "name": "FireGuardAnomalousTelemetryRule",
        "sql": "SELECT * FROM 'fireguard/telemetry/+/+' WHERE temperature > 60 OR smoke > 3.0",
        "action": "LAMBDA_PROCESS_ANOMALY"
      },
      {
        "name": "FireGuardRawArchivalRule",
        "sql": "SELECT * FROM 'fireguard/telemetry/+/+'",
        "action": "DYNAMODB_INGEST"
      }
    ]
  },
  "dynamodb_tables": [
    {
      "table_name": "FireGuard_Telemetry",
      "partition_key": "building_zone_id",
      "sort_key": "timestamp",
      "billing_mode": "PAY_PER_REQUEST",
      "ttl_attribute": "ttl_expiry",
      "ttl_days": 30
    },
    {
      "table_name": "FireGuard_RiskAssessments",
      "partition_key": "assessment_id",
      "sort_key": "calculated_at",
      "billing_mode": "PAY_PER_REQUEST",
      "ttl_attribute": "ttl_expiry",
      "ttl_days": 90
    },
    {
      "table_name": "FireGuard_Alerts",
      "partition_key": "alert_id",
      "sort_key": "timestamp",
      "billing_mode": "PAY_PER_REQUEST"
    }
  ],
  "s3_buckets": {
    "frontend_hosting": {
      "bucket_name_prefix": "fireguard-frontend-static",
      "public_access_block": true,
      "cloudfront_oac_enabled": true
    },
    "incident_reports_archive": {
      "bucket_name_prefix": "fireguard-incident-reports",
      "versioning": true,
      "glacier_transition_days": 180
    }
  },
  "sns_topics": {
    "emergency_alerts": {
      "topic_name": "fireguard-emergency-alerts",
      "display_name": "IgnisCore Fire Emergency Broadcast",
      "kms_master_key_id": "alias/aws/sns"
    }
  },
  "cloudwatch_alarms": [
    {
      "alarm_name": "FireGuard-High-Critical-Incidents",
      "metric_name": "CriticalIncidentCount",
      "namespace": "IgnisCore/Safety",
      "statistic": "Sum",
      "period_seconds": 60,
      "evaluation_periods": 1,
      "threshold": 1,
      "comparison_operator": "GreaterThanOrEqualToThreshold"
    },
    {
      "alarm_name": "FireGuard-ApiGateway-5xx-Spike",
      "metric_name": "5XXError",
      "namespace": "AWS/ApiGateway",
      "statistic": "Average",
      "period_seconds": 300,
      "evaluation_periods": 2,
      "threshold": 5,
      "comparison_operator": "GreaterThanOrEqualToThreshold"
    }
  ]
}
