  "anomaly_scenarios": [
    {
      "id": "scenario_electrical_runaway",
      "title": "Building A Electrical Overheat & Arc Fault",
      "target_zone": "bldg_a_elec",
      "duration_steps": 12,
      "progression_profile": "exponential",
      "peak_temp": 88.0,
      "peak_smoke": 6.8,
      "peak_load": 99.2,
      "cascade_delay_steps": 3
    },
    {
