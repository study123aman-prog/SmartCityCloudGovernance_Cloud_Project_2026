{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": "1.0.0",
  "project": "IgnisCore — Intelligent Fire Hazard Monitoring System",
  "description": "Simulation configuration for Virtual Sensor Telemetry Engine, sensor physics baselines, noise distributions, and hazard anomaly scenarios.",
  "engine": {
    "default_interval_ms": 5000,
    "min_interval_ms": 1000,
    "max_interval_ms": 60000,
    "jitter_ratio": 0.05,
    "api_endpoint": "http://localhost:5001/api/telemetry",
    "telemetry_protocol": "HTTP_REST",
    "mqtt_topic_template": "fireguard/telemetry/{building_id}/{zone_id}"
  },
  "sensor_physics": {
    "temperature": {
      "unit": "celsius",
      "normal_min": 18.0,
      "normal_max": 27.0,
      "noise_std_dev": 0.35,
      "warning_threshold": 45.0,
      "critical_threshold": 65.0
    },
    "optical_smoke": {
      "unit": "obscuration_pct_per_m",
      "normal_min": 0.05,
      "normal_max": 0.40,
      "noise_std_dev": 0.04,
      "warning_threshold": 1.5,
      "critical_threshold": 3.5
    },
    "circuit_load": {
      "unit": "percentage",
      "normal_min": 25.0,
      "normal_max": 65.0,
      "noise_std_dev": 1.5,
      "warning_threshold": 85.0,
      "critical_threshold": 95.0
    },
    "atmospheric_oxygen": {
      "unit": "percentage",
      "normal_baseline": 20.95,
      "noise_std_dev": 0.08,
      "depletion_threshold": 19.5
    }
  },
