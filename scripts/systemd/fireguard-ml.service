[Unit]
Description=FireGuard FastAPI ML Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/fireguard/ml-service
Environment="PATH=/opt/fireguard/ml-service/.venv/bin:/usr/local/bin:/usr/bin"
ExecStart=/opt/fireguard/ml-service/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
