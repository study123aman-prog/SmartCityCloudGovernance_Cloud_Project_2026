# =================================================================
# FireGuard AI - Environment Configuration Template
# =================================================================
# Duplicate this file to .env. Never commit real secrets or credentials.
# All services operate 100% locally without cloud requirements.

# Core Backend Configuration
NODE_ENV=development
PORT=5001
HOST=0.0.0.0
MONGODB_URI=mongodb://localhost:27017/fireguard_ai
JWT_SECRET=fireguard-ai-development-jwt-secret-key-32chars
ML_SERVICE_URL=http://ml-service:8000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
LOCAL_STORAGE_DIR=data/uploads

# Risk Fusion Engine Weights (Normalized convex combination)
FOREST_WEIGHT=0.35
WEATHER_WEIGHT=0.20
BUILDING_WEIGHT=0.30
EXPOSURE_WEIGHT=0.15

# Alert Engine Local Thresholds
ALERT_WARNING_THRESHOLD=60
ALERT_CRITICAL_THRESHOLD=85

# Frontend (Vite)
VITE_API_URL=http://localhost:5001/api

# Future Optional AWS Integrations (Reference only - leave empty for local development)
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# AWS_SNS_TOPIC_ARN=
# AWS_IOT_ENDPOINT=
# DYNAMODB_RISK_TABLE=
